# Local development defaults only. Replace SECRET_KEY before any shared deployment.
SECRET_KEY=replace-this-local-development-key
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
ENABLE_DEMO_API=0

# Local PostgreSQL connection. Keep the real password only in ignored .env.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=school_lms
DB_USER=school_lms
DB_PASSWORD=replace-with-the-local-role-password
DB_HOST=127.0.0.1
DB_PORT=5432
